<script type="text/javascript">

$(document).ready(function(){

    $('#list-of-option').click( function(e) {
        //alert('hello');
        e.preventDefault(); // stops link from making page jump to the top
        e.stopPropagation(); // when you click the button, it stops the page from seeing it as clicking the body too
        $('#user-option').toggle();
    });
    $('#user-option').click( function(e) {
        e.stopPropagation(); // when you click within the content area, it stops the page from seeing it as clicking the body too
    });
    $('body,.user-option-list').click( function() {
        //alert('hello');
       $('#user-option').hide();
    });

    $('#writecomment').click( function(e) {
        e.preventDefault();
        e.stopPropagation(); // when you click the button, it stops the page from seeing it as clicking the body too
        $('#comment_wrapper').toggle();
        $('#report_wrapper').css('display','none');
    });
    $('#comment_wrapper').click( function(e) {
        e.stopPropagation(); // when you click within the content area, it stops the page from seeing it as clicking the body too
    });

    $('#reportcomment').click( function(e) {
        e.preventDefault();
        e.stopPropagation(); // when you click the button, it stops the page from seeing it as clicking the body too
        $('#report_wrapper').toggle();
        $('#comment_wrapper').css('display','none');
    });
    $('#report_wrapper').click( function(e) {
        e.stopPropagation(); // when you click within the content area, it stops the page from seeing it as clicking the body too
    });

});

    var session_user_id = '';
    $(document).ready(function () {
        $('.cmnt_txt1, .like_txt1').click(function () {
            if (!session_user_id || session_user_id == '') {
                gotologin();
                return false;
            }
        });
    });

    function gotologin() {
        $('html, body').animate({scrollTop: $('#menu1').position().top}, 'slow');
        toggle_panel('1');
    }

    // Post Comment
    function post_comment(news_id) {
        var comment_textarea = $("#comment_textarea").val();
        if (comment_textarea == "") {
            $("span#comment_error").html("Please input comment");
        } else {
            $.ajax({
                type: "POST",
                url: "https://www.cityspidey.com/news/post_comment",
                data: {news_id: news_id, content_type: 1, comment_text: comment_textarea},
                dataType: "json",
                beforeSend: function () {
                    $("button.comment_btn").prop('disabled', true);
                },
                success: function (response) {
					console.log(response);
                    if (response == 0) {
                        $("span#comment_error").html("Please login to put comment").delay(20000);
                        //window.location.href = "https://www.cityspidey.com/";
                        $('html, body').animate({scrollTop: $('#menu1').position().top}, 'slow');
                        toggle_panel('1');
                    } else {
                        //$("#comment_wrapper").append(response[0]);
                        $("#comment_wrapper").load(location.href + " #comment_wrapper");
                        $("#comment_textarea").val("");
                        $("span#comment_error").html("");
						$("span#comment_msg").html("Thanks for post comments. your comments display after approval.").delay(100000);
                       // if (response[1] > 1)
                          //  $("span#total_comments").text(response[1] + " Comments");
                       // else
                          //  $("span#total_comments").text(response[1] + " Comment");

                        //$("#comment_wrapper").load(location.href + " #comment_wrapper");
						$('#comment_msg').delay(15000).fadeOut('slow');
                    }
                },
                complete: function () {
                    $("button.comment_btn").prop('disabled', false);
                }
            });
        }
    }

    function post_report(news_id) {
        var report_textarea = $("#report_textarea").val();
        if (report_textarea == "") {
            $("span#report_error").html("Please input report");
        } else {
            $.ajax({
                type: "POST",
                url: "https://www.cityspidey.com/news/report_comment",
                data: {news_id: news_id, content_type: 2, comment_text: report_textarea},
                dataType: "json",
                beforeSend: function () {
                    $("button.comment_btn").prop('disabled', true);
                },
                success: function (response) {
					console.log(response);
                    if (response == 0) {
                        $("span#report_error").html("Please login to report").delay(20000);
                        //window.location.href = "https://www.cityspidey.com/";
                        $('html, body').animate({scrollTop: $('#menu1').position().top}, 'slow');
                        toggle_panel('1');
                    } else {
                        //$("#comment_wrapper").append(response[0]);
                        $("#report_wrapper").load(location.href + " #comment_wrapper");
                        $("#report_textarea").val("");
                        $("span#report_error").html("");
						//$("span#report_msg").html("Thanks for post comments. your comments display after approval.").delay(100000);
                       // if (response[1] > 1)
                          //  $("span#total_comments").text(response[1] + " Comments");
                       // else
                          //  $("span#total_comments").text(response[1] + " Comment");

                        //$("#comment_wrapper").load(location.href + " #comment_wrapper");
						$('#report_msg').delay(15000).fadeOut('slow');
                    }
                },
                complete: function () {
                    $("button.comment_btn").prop('disabled', false);
                }
            });
        }
    }

    // Reply comment area
    function post_comment_reply(news_id, comment_id) {
        var comment_textarea = $("#reply_comment_textarea_" + comment_id).val();
        var getData;
        if (comment_textarea == "") {
            $("span#reply_comment_error_" + comment_id).html("Please input comment");
        } else {
            $.ajax({
                datatype: "json",
                type: "POST",
                url: "https://www.cityspidey.com/news/post_reply_comment",
                data: {news_id: news_id, comment_id: comment_id, content_type: 1, comment_text: comment_textarea},
                beforeSend: function () {
                    $("button.reply_btn").prop('disabled', true);
                },
                success: function (response) {
                    getData = $.parseJSON(response);
                    if (response == 0) {
                        $("span#reply_comment_error_" + comment_id).html("Please login to put comment").delay(20000);
                        window.location.href = "https://www.cityspidey.com/";
                    } else {
                        $("#replies_of_" + comment_id).append(getData[0]);
                        $("#reply_comment_textarea_" + comment_id).val("");
                        $("span#reply_comment_error_" + comment_id).html("");
                        $("#total_replies_" + comment_id).text(getData[1]);
                        $("#replies_of_" + comment_id + " .reply-comment-list-two").fadeIn("slow");
						$("span#replaycomment_msg").html("Thanks for post comments. your comments disply after approval.").delay(100000);
                       // if (getData[2] > 1)
                           // $("span#total_comments").text(getData[2] + " Comments");
                        //else
                            //$("span#total_comments").text(getData[2] + " Comment");
						

				$('#replaycomment_msg').delay(15000).fadeOut('slow');


                        $("#reply_to_" + comment_id).css('display', 'none');
                    }
                },
                complete: function () {
                    $("button.reply_btn").prop('disabled', false);
                }
            });
        }
    }

    // Like Comment
    function saveCommentLike(news_id, comment_id, like_type) {
        $.ajax({
            type: "POST",
            url: "https://www.cityspidey.com/news/comment_like_actions",
            data: {news_id: news_id, comment_id: comment_id, like_type: like_type},
            success: function (response) {
                // Parse JSON data
                var getData = $.parseJSON(response);

                // Likes
                if (getData[0] == 0) {
                    $("#like_" + comment_id).html("Like");
                } else if (getData[0] == 1) {
                    $("#like_" + comment_id).html(getData[0] + " Like");
                } else if (getData[0] > 1) {
                    $("#like_" + comment_id).html(getData[0] + " Likes");
                }

                // Dislikes
                if (getData[1] == 0) {
                    $("#dislike_" + comment_id).html("Dislike");
                } else if (getData[1] == 1) {
                    $("#dislike_" + comment_id).html(getData[1] + " Dislike");
                } else if (getData[1] > 1) {
                    $("#dislike_" + comment_id).html(getData[1] + " Dislikes");
                }

                // if(like_type == 1 ) {
                //     if( response == 0 ) {
                //         $("#like_"+comment_id).html("Like");
                //     }
                //     else if( response == 1 ) {
                //         $("#like_"+comment_id).html(response+" Like");
                //     }
                //     else if( response > 1 ) {
                //         $("#like_"+comment_id).html(response+" Likes");
                //     }
                // }
                // else if( like_type == 2 ) {
                //     if( response == 0 ) {
                //         $("#dislike_"+comment_id).html("Dislike");
                //     }
                //     else if( response == 1 ) {
                //         $("#dislike_"+comment_id).html(response+" Dislike");
                //     }
                //     else if( response > 1 ) {
                //         $("#dislike_"+comment_id).html(response+" Dislikes");
                //     }
                // }

            }
        });
    }

    // Like News
    function likeNews(news_id) {
		//alert(news_id);
        $.ajax({
            type: "POST",
            url: "https://www.cityspidey.com/news/news_like_actions",
            data: {news_id: news_id},
            dataType: "JSON",
            success: function (response) {
				//console.log(response);
				//alert(response); 
				//return false;
                $("#news_like_" + news_id).html(response[0]);

                if (response[1] == null) {
                   $("#button_news_like_" + news_id).removeClass("fa-thumbs-down");
                   $("#button_news_like_" + news_id).addClass("fa-thumbs-up");
                   $("#button_news_like_" + news_id).attr("title", "Click to like");
               } else {
                   $("#button_news_like_" + news_id).removeClass("fa-thumbs-up");
                   $("#button_news_like_" + news_id).addClass("fa-thumbs-down");
                   $("#button_news_like_" + news_id).attr("title", "Click to dislike");
               }
            }
        });
    }
	
	function addLikes(userid, id, action, type) {
	$('#group-' + id + ' li').each(function (index) {
		$(this).addClass('selected');
		$('#group-' + id + ' #rating').val((index + 1));
		if (index == $('#group-' + id + ' li').index(obj)) {
			return false;
		}
	});
	$.ajax({
		url:"https://www.cityspidey.com/news/addLikes",
		data: 'user_id=' + userid + '&id=' + id + '&type=' + type + '&action=' + action,
		type: "POST",
		 beforeSend: function () {
            $('#group-' + id + ' .btn-likes').html('<img src=assets/images/loaderIcon.gif />');
         },
		success: function (data) {
			var likes = parseInt($('#likes-' + id).val());
			switch (action) {
				case "like":
					$('#group-' + id + ' .btn-likes').html('<input type="button" title="Unlike" class="unlike" onClick="addLikes(\'' + userid + '\',' + id + ',\'unlike\',' + type + ')" />');
					likes = likes + 1;
					break;
				case "unlike":
					$('#group-' + id + ' .btn-likes').html('<input type="button" title="Like" class="like"  onClick="addLikes(\'' + userid + '\',' + id + ',\'like\',' + type + ')" />');
					likes = likes - 1;
					break;
			}
			$('#likes-' + id).val(likes);
			if (likes > 0) {
				$('#group-' + id + ' .label-likes').html(likes + " LIKE(S)");
			} else {
				$('#group-' + id + ' .label-likes').html('LIKE');
			}
		}
	});
}

    // Add Comment Field on a comment reply
    function addReplyComment(comment_id) {
        $(".reply-box").css('display', 'none');
        $("#reply_to_" + comment_id).fadeIn("slow");
        $(".comment-sec-right").addClass("reply-float");
        $(".bottom-like-unlike-reply").addClass("replyspace");
        $('html, body').animate({scrollTop:
                    $('#reply_to_' + comment_id).position().top - 50
        }, 'slow');
    }

    // Close Comment Field on click Cancel
    function closeReplyComment(comment_id) {
        $("#reply_to_" + comment_id).fadeOut("slow");
    }

    function showReplies(comment_id) {
        $("#replies_of_" + comment_id + " .reply-comment-list-two").slideToggle("slow");
    }

    // Play pause video
    var myVideo = document.getElementById("story_video");

    function playPause() {
        if (myVideo.paused)
            myVideo.play();
        else
            myVideo.pause();
    }

    function scrollToCommentBox() {
        $('html, body').animate({
            scrollTop: $('#textarea_box').position().top - 50
        }, 'slow');
    }
</script>

